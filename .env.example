# =============================================================================
# REQUIRED CORE (§10.1)
# All variables in this section must be set before starting the app.
# =============================================================================

# Postgres connection string. @db resolves to the db container on the Docker network.
DATABASE_URL=postgres://forkd:CHANGE_ME@db:5432/forkd

# 32-byte base64 key that encrypts all secrets stored in the app_config table.
# Generate once with: openssl rand -base64 32
# BACK THIS UP OUT-OF-BAND — losing it means losing all encrypted config.
MASTER_KEY=CHANGE_ME_BASE64_KEY

# Public URL of this Forkd instance. Used for auth callbacks and session cookie domain.
AUTH_URL=https://forkd.example.com

# Docker Compose reads these three to initialise the Postgres container.
POSTGRES_USER=forkd
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=forkd

# =============================================================================
# SERVICE URLS (§10.2)
# Defaults match the Docker Compose service names. Only change if you deviate.
# =============================================================================

REDIS_URL=redis://redis:6379
CHROME_CDP_ENDPOINT=http://chrome-headless:3000
UPLOADS_DIR=/app/uploads
BACKUPS_DIR=/app/backups

# =============================================================================
# OPTIONAL RUNTIME (§10.3)
# =============================================================================

NODE_ENV=production
HOST=0.0.0.0
# Port the app listens on inside the container AND the port Docker binds on the host.
# Changing this one value controls both — no need to edit docker-compose.yml.
PORT=3000
# Docker image used by the webapp container.
# Default (when unset): ghcr.io/pmalcolm99/forkd:latest — the published release image.
# Local development: uncomment and set to forkd:latest to use the locally built image.
# IMAGE_LOCATION=forkd:latest
# Comma-separated extra origins allowed for authenticated requests (e.g. LAN IP)
TRUSTED_ORIGINS=
# Months before soft-deleted records are purged by the cleanup scheduler
SCHEDULER_CLEANUP_MONTHS=3
# Max bytes per uploaded photo (default 10 MB)
MAX_IMAGE_FILE_SIZE=10485760
LOG_LEVEL=info

# =============================================================================
# AUTHENTICATION — BOOTSTRAP ONLY (§10.4)
# =============================================================================

# auto: enables password auth until the first user is created, then disables it.
# After bootstrap, identity comes from Cloudflare Access, not passwords.
PASSWORD_AUTH_ENABLED=auto
# Keep false in production — new users arrive via Cloudflare Access, not self-signup.
ENABLE_REGISTRATION=false

# =============================================================================
# CLOUDFLARE ACCESS INTEGRATION (§10.5)
# =============================================================================

# The Application Audience tag shown in the Cloudflare Access dashboard.
CF_ACCESS_AUD=CHANGE_ME
# Your Cloudflare team domain, e.g. myteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=CHANGE_ME.cloudflareaccess.com
# Set to true once Cloudflare Access is in front of this instance.
CF_ACCESS_ENABLED=false

# =============================================================================
# AI PROVIDER (§10.6)
# =============================================================================

AI_ENABLED=false
# anthropic is the preferred provider for Forkd.
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-4-7
AI_TEMPERATURE=1.0
AI_MAX_TOKENS=4000
AI_TIMEOUT_MS=300000
# NOTE: AI_API_KEY is intentionally absent here.
# In production, set it via the admin UI — it is stored encrypted in the database.
# For local development only, you may set it here:
# AI_API_KEY=CHANGE_ME

# =============================================================================
# TRANSCRIPTION / WHISPER (§10.7)
# =============================================================================

TRANSCRIPTION_PROVIDER=disabled
TRANSCRIPTION_MODEL=whisper-1

# =============================================================================
# VIDEO IMPORT (§10.8)
# =============================================================================

VIDEO_PARSING_ENABLED=true
# Videos longer than this many seconds are rejected (prevents huge downloads).
VIDEO_MAX_LENGTH_SECONDS=120
YT_DLP_VERSION=latest
YT_DLP_BIN_DIR=/usr/local/bin

# =============================================================================
# PWA / APP (§10.9)
# =============================================================================

APP_NAME=Forkd
APP_THEME_COLOR=#0f172a
