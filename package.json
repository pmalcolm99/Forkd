{
  "name": "forkd",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "prepare": "husky",
    "db:generate": "pnpm --filter=@forkd/db db:generate",
    "db:migrate": "pnpm --filter=@forkd/db db:migrate",
    "db:push": "pnpm --filter=@forkd/db db:push",
    "db:seed": "pnpm --filter=@forkd/db db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@secretlint/secretlint-rule-preset-recommend": "^8.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "secretlint": "^8.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "lint-staged": {
    "*": "secretlint --maskSecrets",
    "**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "**/*.{json,md,yaml,yml,css}": [
      "prettier --write"
    ]
  }
}
